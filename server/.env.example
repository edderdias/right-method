# App
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173

# Database (matches docker-compose.yml postgres service)
DATABASE_URL=postgresql://right_method:right_method@localhost:5432/right_method_auth?schema=public

# Redis (rate limiting / brute-force lockout)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# Access token lifetime. The frontend renews it silently via POST /auth/refresh, so a short
# window here just controls how often that round-trip happens during active use.
JWT_ACCESS_EXPIRES_IN=1h
# Refresh token lifetime / inactivity window. Each successful /auth/refresh rotates the token and
# resets this clock, so an active user is never logged out; an idle one falls back to login after
# this many days.
JWT_REFRESH_EXPIRES_IN_DAYS=30

# SMTP (points to the Mailhog container in local dev — see docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Método Certo <no-reply@metodocerto.app>"
SMTP_SECURE=false

# Pluggy (Open Finance) — client ID/secret are no longer set here: each user creates a free
# account at https://dashboard.pluggy.ai and registers their own credentials in Configurações.
PLUGGY_BASE_URL=https://api.pluggy.ai
# Shared secret appended as ?token= to the webhook URL registered with Pluggy — Pluggy webhooks
# have no built-in signature verification, this is the recommended way to authenticate them.
PLUGGY_WEBHOOK_SECRET=
OPEN_FINANCE_INITIAL_SYNC_DAYS=365
# Public base URL of this API (e.g. an ngrok URL in dev) used to register the Pluggy webhook.
# Optional — without it, accounts still sync via the manual "Sincronizar agora" action.
API_PUBLIC_URL=

# AI providers (Certo IA assistant) — each user can register their own provider + key in
# Configurações for unlimited use. A user WITHOUT their own key falls back to a shared key:
# GOOGLE_API_KEY (Gemini) if set, otherwise OPENAI_API_KEY. Shared-key usage is capped per user
# per day by AI_FREE_DAILY_LIMIT.
#
# GOOGLE_API_KEY enables the free "modo gratuito" for every user — get one at
# https://aistudio.google.com/apikey. Note: on Google's FREE tier your prompts may be used to
# improve their products; users who need privacy should register their own (paid) key.
GOOGLE_API_KEY=
AI_FREE_DAILY_LIMIT=20

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GOOGLE_MODEL=gemini-3.6-flash
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta