# App
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173

# Database (matches docker-compose.yml postgres service)
DATABASE_URL=postgresql://right_method:right_method@localhost:5432/right_method_auth?schema=public

# Redis (rate limiting / brute-force lockout)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# SMTP (points to the Mailhog container in local dev — see docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Método Certo <no-reply@metodocerto.app>"
SMTP_SECURE=false
