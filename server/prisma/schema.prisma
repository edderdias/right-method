generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

enum AuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_RESENT
  REGISTER
  REFRESH_TOKEN
  SESSION_REVOKED
  OPEN_FINANCE_CONNECTION_CREATED
  OPEN_FINANCE_ACCOUNT_ADDED
  OPEN_FINANCE_ACCOUNT_DISCONNECTED
  OPEN_FINANCE_SYNC_COMPLETED
  OPEN_FINANCE_SYNC_FAILED
  OPEN_FINANCE_WEBHOOK_RECEIVED
  FAMILY_INVITE_CREATED
  FAMILY_INVITE_REDEEMED
  FAMILY_ACCESS_REVOKED
}

enum FamilyInviteStatus {
  PENDING
  REDEEMED
  REVOKED
  EXPIRED
}

enum ConnectionStatus {
  CONNECTED
  SYNCING
  REQUIRES_REAUTH
  EXPIRED
  ERROR
  DISCONNECTED
}

enum BankTransactionType {
  CREDIT
  DEBIT
}

enum TransactionSource {
  MANUAL
  OPEN_FINANCE
  CARD
}

enum CreditCardSource {
  MANUAL
  OPEN_FINANCE
}

enum CreditCardStatus {
  ACTIVE
  ARCHIVED
}

enum CreditCardInvoiceStatus {
  OPEN
  CLOSED
  DUE
  PAID
  OVERDUE
}

enum CardPurchaseSource {
  MANUAL
  OPEN_FINANCE
}

enum InvestmentType {
  RENDA_FIXA
  ACOES
  FIIS
  ETFS
  TESOURO_DIRETO
  FUNDOS
  CRIPTOMOEDAS
  PREVIDENCIA
  POUPANCA
  OUTROS
}

enum InvestmentSource {
  MANUAL
  OPEN_FINANCE
}

enum InvestmentStatus {
  ACTIVE
  ARCHIVED
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  DEPOSIT
  WITHDRAW
}

enum InvestmentTransactionSource {
  MANUAL
  OPEN_FINANCE
}

enum InvestmentIncomeType {
  DIVIDENDO
  JUROS
  RENDIMENTO_FII
  JCP
  CUPOM
  OUTROS
}

enum FinancialGoalCategory {
  RESERVA_EMERGENCIA
  VIAGEM
  CASA
  CARRO
  EDUCACAO
  APOSENTADORIA
  INVESTIMENTO
  COMPRA
  DIVIDA
  NEGOCIO
  OUTROS
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum FinancialGoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum GoalTransactionType {
  DEPOSIT
  WITHDRAW
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  passwordHash  String
  emailVerified Boolean    @default(false)
  status        UserStatus @default(PENDING)
  role          UserRole   @default(USER)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  phone    String?
  currency String  @default("BRL")

  notifyBillDue      Boolean @default(true)
  notifyCardInvoice  Boolean @default(true)
  notifyGoalProgress Boolean @default(true)
  notifyLowBalance   Boolean @default(false)
  notifyInvestment   Boolean @default(true)

  biometricEnabled      Boolean @default(false)
  twoFactorEnabled      Boolean @default(false)
  newDeviceAlertEnabled Boolean @default(true)
  hideBalances          Boolean @default(false)

  twoFactorSecretEncrypted String?

  aiProvider        AiProvider @default(OPENAI)
  aiApiKeyEncrypted String?

  pluggyClientId              String?
  pluggyClientSecretEncrypted String?

  sessions               UserSession[]
  verificationTokens     VerificationToken[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  webAuthnCredentials    WebAuthnCredential[]
  accounts               Account[]
  accountTransfers       AccountTransfer[]
  categories             Category[]
  revenues               Revenue[]
  expenses               Expense[]
  openFinanceConnections OpenFinanceConnection[]
  connectedAccounts      ConnectedAccount[]
  bankTransactions       BankTransaction[]
  creditCards            CreditCard[]
  creditCardInvoices     CreditCardInvoice[]
  creditCardPurchases    CreditCardPurchase[]
  investments            Investment[]
  investmentTransactions InvestmentTransaction[]
  investmentIncomes      InvestmentIncome[]
  financialGoals         FinancialGoal[]
  goalTransactions       GoalTransaction[]
  aiConversations        AiConversation[]
  sentFamilyInvites      FamilyInvite[]           @relation("InviterInvites")
  redeemedFamilyInvites  FamilyInvite[]           @relation("RedeemedInvites")
  familyGrantsAsOwner    FamilyAccessGrant[]      @relation("OwnerGrants")
  familyGrantsAsMember   FamilyAccessGrant[]      @relation("MemberGrants")

  @@map("users")
}

model FamilyInvite {
  id           String             @id @default(uuid())
  inviterId    String
  code         String             @unique
  status       FamilyInviteStatus @default(PENDING)
  redeemedById String?
  redeemedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  inviter    User  @relation("InviterInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  redeemedBy User? @relation("RedeemedInvites", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([inviterId])
  @@map("family_invites")
}

model FamilyAccessGrant {
  id        String    @id @default(uuid())
  ownerId   String
  memberId  String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  owner  User @relation("OwnerGrants", fields: [ownerId], references: [id], onDelete: Cascade)
  member User @relation("MemberGrants", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
  @@map("family_access_grants")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model AuditLog {
  id        String     @id @default(uuid())
  userId    String?
  event     AuditEvent
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@map("audit_logs")
}

model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

enum NotificationType {
  BILL_DUE
  CARD_INVOICE_CLOSING
  CARD_INVOICE_DUE
  GOAL_MILESTONE
  LOW_BALANCE
  INVESTMENT_INCOME
  INVESTMENT_MATURITY
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  entityId  String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, entityId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum RevenueStatus {
  PENDING
  RECEIVED
  OVERDUE
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

enum RecurrenceType {
  MONTHLY
  WEEKLY
  BIWEEKLY
  YEARLY
  CUSTOM
}

enum CategoryType {
  REVENUE
  EXPENSE
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  revenues                 Revenue[]
  expenses                 Expense[]
  linkedGoals              FinancialGoal[]   @relation("GoalLinkedAccount")
  goalTransactionsAsSource GoalTransaction[] @relation("GoalTransactionSourceAccount")
  transfersOut             AccountTransfer[] @relation("AccountTransfersOut")
  transfersIn              AccountTransfer[] @relation("AccountTransfersIn")

  @@index([userId])
  @@map("accounts")
}

model AccountTransfer {
  id            String   @id @default(uuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(12, 2)
  transferDate  DateTime @db.Date
  description   String?
  createdAt     DateTime @default(now())

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("AccountTransfersOut", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account @relation("AccountTransfersIn", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("account_transfers")
}

model Category {
  id        String       @id @default(uuid())
  userId    String?
  name      String
  type      CategoryType
  createdAt DateTime     @default(now())

  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  revenues            Revenue[]
  expenses            Expense[]
  bankTransactions    BankTransaction[]
  creditCardPurchases CreditCardPurchase[]

  @@index([userId])
  @@index([type])
  @@map("categories")
}

model Revenue {
  id          String        @id @default(uuid())
  userId      String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  categoryId  String
  accountId   String
  dueDate     DateTime      @db.Date
  receivedAt  DateTime?     @db.Date
  status      RevenueStatus @default(PENDING)
  notes       String?

  isRecurring       Boolean         @default(false)
  recurrenceType    RecurrenceType?
  recurrenceEndDate DateTime?       @db.Date
  parentRevenueId   String?

  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  attachmentUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category  @relation(fields: [categoryId], references: [id])
  account       Account   @relation(fields: [accountId], references: [id])
  parentRevenue Revenue?  @relation("RevenueRecurrence", fields: [parentRevenueId], references: [id], onDelete: SetNull)
  childRevenues Revenue[] @relation("RevenueRecurrence")

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([categoryId])
  @@index([accountId])
  @@map("revenues")
}

model Expense {
  id          String        @id @default(uuid())
  userId      String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  categoryId  String
  accountId   String
  dueDate     DateTime      @db.Date
  paidAt      DateTime?     @db.Date
  status      ExpenseStatus @default(PENDING)
  notes       String?

  isRecurring       Boolean         @default(false)
  recurrenceType    RecurrenceType?
  recurrenceEndDate DateTime?       @db.Date
  parentExpenseId   String?

  isInstallment      Boolean @default(false)
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  creditCardId  String?
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category  @relation(fields: [categoryId], references: [id])
  account       Account   @relation(fields: [accountId], references: [id])
  parentExpense Expense?  @relation("ExpenseRecurrence", fields: [parentExpenseId], references: [id], onDelete: SetNull)
  childExpenses Expense[] @relation("ExpenseRecurrence")

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([categoryId])
  @@index([accountId])
  @@index([installmentGroupId])
  @@map("expenses")
}

model OpenFinanceConnection {
  id                  String           @id @default(uuid())
  userId              String
  provider            String           @default("PLUGGY")
  providerItemId      String           @unique
  institutionName     String
  institutionImageUrl String?
  status              ConnectionStatus @default(SYNCING)
  statusDetail        String?
  lastSyncAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts    ConnectedAccount[]
  creditCards CreditCard[]
  investments Investment[]

  @@index([userId])
  @@map("open_finance_connections")
}

model ConnectedAccount {
  id                String           @id @default(uuid())
  userId            String
  connectionId      String
  externalAccountId String
  accountType       String
  accountSubtype    String
  name              String
  marketingName     String?
  numberMasked      String?
  balance           Decimal          @default(0) @db.Decimal(14, 2)
  currencyCode      String           @default("BRL")
  status            ConnectionStatus @default(SYNCING)
  lastSyncAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   OpenFinanceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([connectionId, externalAccountId])
  @@index([userId])
  @@map("connected_accounts")
}

model BankTransaction {
  id                    String              @id @default(uuid())
  userId                String
  accountId             String
  externalTransactionId String
  description           String
  merchantName          String?
  amount                Decimal             @db.Decimal(14, 2)
  type                  BankTransactionType
  status                String              @default("POSTED")
  transactionDate       DateTime            @db.Date
  categoryId            String?
  notes                 String?
  source                TransactionSource   @default(OPEN_FINANCE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])

  @@unique([accountId, externalTransactionId])
  @@index([userId])
  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@map("bank_transactions")
}

model CreditCard {
  id              String           @id @default(uuid())
  userId          String
  connectionId    String?
  externalCardId  String?
  institutionName String?
  name            String
  brand           String?
  lastFourDigits  String?
  creditLimit     Decimal?         @db.Decimal(12, 2)
  availableLimit  Decimal?         @db.Decimal(12, 2)
  closingDay      Int?
  dueDay          Int?
  source          CreditCardSource @default(MANUAL)
  status          CreditCardStatus @default(ACTIVE)
  lastSyncAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection OpenFinanceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  invoices   CreditCardInvoice[]
  purchases  CreditCardPurchase[]

  @@unique([connectionId, externalCardId])
  @@index([userId])
  @@map("credit_cards")
}

model CreditCardInvoice {
  id                String                  @id @default(uuid())
  userId            String
  cardId            String
  referenceMonth    DateTime                @db.Date
  closingDate       DateTime                @db.Date
  dueDate           DateTime                @db.Date
  totalAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  status            CreditCardInvoiceStatus @default(OPEN)
  paidAt            DateTime?
  paidFromAccountId String?
  paidExpenseId     String?
  reversedAt        DateTime?
  reversalReason    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      CreditCard           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  purchases CreditCardPurchase[]

  @@unique([cardId, referenceMonth])
  @@index([userId])
  @@map("credit_card_invoices")
}

model CreditCardPurchase {
  id                    String             @id @default(uuid())
  userId                String
  cardId                String
  invoiceId             String
  externalTransactionId String?
  description           String
  merchantName          String?
  amount                Decimal            @db.Decimal(12, 2)
  purchaseDate          DateTime           @db.Date
  categoryId            String?
  responsibleName       String?
  source                CardPurchaseSource @default(MANUAL)
  installmentGroupId    String?
  installmentNumber     Int?
  installmentTotal      Int?
  notes                 String?

  isRecurring       Boolean   @default(false)
  recurrenceEndDate DateTime? @db.Date
  parentPurchaseId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           CreditCard           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  invoice        CreditCardInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category       Category?            @relation(fields: [categoryId], references: [id])
  parentPurchase CreditCardPurchase?  @relation("PurchaseRecurrence", fields: [parentPurchaseId], references: [id], onDelete: SetNull)
  childPurchases CreditCardPurchase[] @relation("PurchaseRecurrence")

  @@unique([cardId, externalTransactionId])
  @@index([userId])
  @@index([invoiceId])
  @@index([installmentGroupId])
  @@index([cardId, responsibleName])
  @@index([isRecurring])
  @@index([parentPurchaseId])
  @@map("credit_card_purchases")
}

model Investment {
  id                   String           @id @default(uuid())
  userId               String
  connectionId         String?
  externalInvestmentId String?
  type                 InvestmentType
  ticker               String?
  name                 String
  institutionName      String?
  quantity             Decimal          @default(0) @db.Decimal(18, 8)
  averagePrice         Decimal?         @db.Decimal(12, 2)
  investedAmount       Decimal          @default(0) @db.Decimal(12, 2)
  currentValue         Decimal          @default(0) @db.Decimal(12, 2)
  currentPrice         Decimal?         @db.Decimal(12, 2)
  issuer               String?
  rate                 String?
  indexer              String?
  maturityDate         DateTime?        @db.Date
  liquidity            String?
  source               InvestmentSource @default(MANUAL)
  status               InvestmentStatus @default(ACTIVE)
  lastSyncAt           DateTime?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   OpenFinanceConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  transactions InvestmentTransaction[]
  incomes      InvestmentIncome[]
  goalLinks    GoalInvestmentLink[]

  @@unique([connectionId, externalInvestmentId])
  @@index([userId])
  @@map("investments")
}

model InvestmentTransaction {
  id                    String                      @id @default(uuid())
  userId                String
  investmentId          String
  externalTransactionId String?
  type                  InvestmentTransactionType
  quantity              Decimal?                    @db.Decimal(18, 8)
  unitPrice             Decimal?                    @db.Decimal(12, 2)
  amount                Decimal                     @db.Decimal(12, 2)
  fees                  Decimal                     @default(0) @db.Decimal(12, 2)
  transactionDate       DateTime                    @db.Date
  realizedGain          Decimal?                    @db.Decimal(12, 2)
  notes                 String?
  source                InvestmentTransactionSource @default(MANUAL)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([investmentId, externalTransactionId])
  @@index([userId])
  @@index([investmentId])
  @@map("investment_transactions")
}

model InvestmentIncome {
  id           String               @id @default(uuid())
  userId       String
  investmentId String
  type         InvestmentIncomeType
  amount       Decimal              @db.Decimal(12, 2)
  paymentDate  DateTime             @db.Date
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([investmentId])
  @@map("investment_incomes")
}

model FinancialGoal {
  id              String                @id @default(uuid())
  userId          String
  name            String
  description     String?
  category        FinancialGoalCategory
  priority        GoalPriority          @default(MEDIUM)
  targetAmount    Decimal               @db.Decimal(12, 2)
  initialAmount   Decimal               @default(0) @db.Decimal(12, 2)
  currentAmount   Decimal               @default(0) @db.Decimal(12, 2)
  startDate       DateTime              @db.Date
  targetDate      DateTime              @db.Date
  status          FinancialGoalStatus   @default(ACTIVE)
  linkedAccountId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccount   Account?             @relation("GoalLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  transactions    GoalTransaction[]
  investmentLinks GoalInvestmentLink[]

  @@index([userId])
  @@index([userId, status])
  @@map("financial_goals")
}

model GoalTransaction {
  id              String              @id @default(uuid())
  userId          String
  goalId          String
  type            GoalTransactionType
  amount          Decimal             @db.Decimal(12, 2)
  transactionDate DateTime            @db.Date
  sourceAccountId String?
  description     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sourceAccount Account?      @relation("GoalTransactionSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([goalId])
  @@map("goal_transactions")
}

model GoalInvestmentLink {
  id           String   @id @default(uuid())
  goalId       String
  investmentId String
  createdAt    DateTime @default(now())

  goal       FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  investment Investment    @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([goalId, investmentId])
  @@index([goalId])
  @@index([investmentId])
  @@map("goal_investment_links")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("Nova conversa")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AiMessageRole
  content        String
  suggestedRoute String?
  suggestedLabel String?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}
